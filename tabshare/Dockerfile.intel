# 基于通用版 tabshare 镜像，添加 Intel 核显硬件加速支持
# 构建前需先构建通用版: docker compose build tabshare
FROM bs-tabshare

USER root

# 安装 Intel iHD 驱动 (硬件编解码 VA-API)
RUN apt-get update && apt-get install -y --no-install-recommends \
    intel-media-va-driver-non-free \
    libigdgmm12 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# 指定 VA-API 驱动
ENV LIBVA_DRIVER_NAME=iHD

USER ubuntu
