# 基于通用版 tabshare 镜像，添加 Intel 核显硬件加速支持
# 构建前需先构建通用版: docker compose build tabshare
FROM bs-tabshare

USER root

# 安装 Intel iHD 驱动 + Xvfb 虚拟显示 + Mesa DRI (GPU 渲染)
RUN apt-get update && apt-get install -y --no-install-recommends \
    intel-media-va-driver-non-free \
    libigdgmm12 \
    libegl1 \
    libgl1-mesa-dri \
    xvfb \
    vainfo \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# 指定 VA-API 驱动
ENV LIBVA_DRIVER_NAME=iHD

USER ubuntu

# Xvfb 虚拟显示启动，Chrome 可完整使用 GPU 渲染+编码
CMD ["xvfb-run", "--server-args=-screen 0 1280x720x24 +extension GLX", "python", "-u", "-m", "server.app"]
